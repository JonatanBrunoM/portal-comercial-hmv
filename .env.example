# Portal Comercial HMV
# Copie para .env apenas em desenvolvimento local.
# NUNCA versione valores reais.

# Supabase server-side
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_EXEMPLO
# Compatibilidade legada, se necessário:
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET
PORTAL_BASE_URL=http://localhost:8080

# Sessão NiceGUI / Starlette
PORTAL_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Criptografia Fernet das senhas externas
# Gere uma chave Fernet válida fora do repositório.
PORTAL_CREDENTIALS_FERNET_KEY=COLOQUE_A_CHAVE_FERNET_AQUI
